# ASSET-FORGE — environment template (SAFE to commit; contains NO real values).
#
# Two secure ways to provide these — pick one:
#   1) Set them as secrets / environment variables in your Claude Code on the
#      web environment settings (preferred — never touches git or chat).
#   2) Run `bash asset-forge/scripts/set_secret.sh` in your own terminal to
#      write a git-ignored asset-forge/.env (hidden input, value never shown).
#
# Phase 5 (scripts/classify.py) reads the environment first, then .env.

# OpenRouter API key for the free-model bulk-classification pass (Phase 5).
OPENROUTER_API_KEY=

# Free model slug to route classification through (e.g. a $0 OpenRouter model).
OPENROUTER_MODEL=
